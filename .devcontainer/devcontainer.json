{
  "name": "r-base",
  // Pinned to 4.5: R 4.6 breaks the vscode-R session watcher, so htmlwidgets/plots
  // fall back to xdg-open (REditorSupport/vscode-R#1696). Revert to :4 once
  // vscode-R 3.0.0 is released as stable.
  "image": "ghcr.io/rocker-org/devcontainer/r-ver:4.5",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/rocker-org/devcontainer-features/r-packages:1": {
      "packages": "broom,broom.helpers,broom.mixed,bslib,conflicted,crew,data.table,devtools,dotenv,DT,foreign,glue,gt,gtsummary,here,janitor,knitr,labelled,languageserver,lavaan,lintr,lme4,lmerTest,markdown,qs2,quarto,readxl,rlang,rmarkdown,rstudioapi,shiny,shinyWidgets,shinybusy,tarchetypes,targets,tidyverse,visNetwork,github::milesmcbain/fnmate,github::milesmcbain/tflow",
      "installSystemRequirements": true,
      // "stable" forces a current pak before installing packages. The pak bundled
      // in the frozen r-ver:4.5 image is old enough that pak::pak() upgrades pak
      // itself mid-run, corrupting its own private library and failing the build.
      "pakVersion": "stable"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/rocker-org/devcontainer-features/quarto-cli:1": {},
    "ghcr.io/rocker-org/devcontainer-features/r-history:0": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // Docker CLI talking to the host daemon via the mounted socket. The mount
    // is contributed by the feature's metadata and propagates downstream.
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    // Ubuntu installs fd-find as `fdfind` and bat as `batcat`.
    "ghcr.io/devcontainers-extra/features/apt-packages:1": {
      "packages": "jq,ripgrep,fd-find,bat,tree,htop,tmux"
    }
  },
  "overrideFeatureInstallOrder": [
    "ghcr.io/devcontainers/features/node"
  ],
  "containerEnv": {
    // Claude Code stores login state in ~/.claude.json, outside ~/.claude, so a
    // volume mounted at ~/.claude alone doesn't survive rebuilds. Pointing
    // CLAUDE_CONFIG_DIR at ~/.claude relocates all state into the mount.
    "CLAUDE_CONFIG_DIR": "/home/rstudio/.claude",
    // gh stores its OAuth token in hosts.yml under this dir. Pointing it at a
    // dedicated path lets projects persist login in a volume, same as Claude.
    "GH_CONFIG_DIR": "/home/rstudio/.gh"
  },
  "customizations": {
    "vscode": {
      // Grouped by theme, alphabetical within each theme. README.md lists these
      // in the same order.
      "extensions": [
        // R and Quarto
        "Posit.air-vscode",
        "quarto.quarto",
        "RDebugger.r-debugger",
        "REditorSupport.r",
        // AI assistants
        "anthropic.claude-code",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        // Git and GitHub
        "GitHub.vscode-pull-request-github",
        // Python
        "charliermarsh.ruff",
        "ms-python.python",
        "ms-toolsai.jupyter",
        // Markdown
        "darkriszty.markdown-table-prettify",
        "DavidAnson.vscode-markdownlint",
        "yzhang.markdown-all-in-one",
        // Data and document formats
        "janisdd.vscode-edit-csv",
        "mechatroner.rainbow-csv",
        "redhat.vscode-yaml",
        "tomoki1207.pdf",
        // Editor tooling
        "adpyke.codesnap",
        "christian-kohler.path-intellisense",
        "ms-azuretools.vscode-docker",
        "ms-vscode.live-server",
        "streetsidesoftware.code-spell-checker",
        "streetsidesoftware.code-spell-checker-australian-english",
        "streetsidesoftware.code-spell-checker-scientific-terms"
      ],
      "settings": {
        "[r]": {
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "Posit.air-vscode"
        },
        "[quarto]": {
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "quarto.quarto"
        },
        "[python]": {
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "[markdown]": {
          "editor.formatOnSave": true
        },
        "r.rterm.linux": "/usr/local/bin/radian",
        "r.bracketedPaste": true,
        "cSpell.language": "en,en-AU",
        "files.eol": "\n"
      }
    }
  }
}